<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon: the app icon as a rounded-square tile (not the launcher's mask shape), sized so its
    corners stay inside the circle the splash screen shows. A plain layer list rather than the
    adaptive icon, because core-splashscreen crops adaptive icons on API 26-30.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_splash_tile" />
    <item android:drawable="@drawable/ic_splash_foreground" />
</layer-list>
